# Everything is optional. The game runs with none of these set.

# Enables AI-generated questions (server-side only). Without it, the built-in bank of 210 questions is used.
ANTHROPIC_API_KEY=
# QUIZ_AI_MODEL=claude-sonnet-5-5

# Where the SQLite database lives. Point this at a persistent disk in production.
# DATABASE_PATH=/data/quiz.db

# Set to 1 when running behind a reverse proxy / PaaS so rate limiting sees real client IPs.
# TRUST_PROXY=1

# Secret used to sign player session tokens. If unset, one is generated and stored next to the database.
# SESSION_SECRET=

# Game tuning (defaults shown)
# QUESTION_SECONDS=20
# REVEAL_SECONDS=6
# PORT=3000
